<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Quality - Sistema de Pedidos' %></title>

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Estilos propios -->
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light">
  <header class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/empleado/pedidos/nuevo">
        <img
          src="/img/quality.png"
          alt="Quality"
          width="32"
          height="32"
          class="rounded-circle bg-white p-1"
        />
        <span class="fw-semibold">Quality · Sistema de Pedidos</span>
      </a>

      <% 
        const subtitle =
          typeof headerSubtitle !== 'undefined' && headerSubtitle
            ? headerSubtitle
            : 'Módulo empleado';
      %>

      <span class="navbar-text text-white-50 small">
        <%= subtitle %>
      </span>
    </div>
  </header>

  <!-- Main centrado horizontal y vertical (md+), y empujando el footer abajo -->
  <main class="d-flex justify-content-center align-items-start align-items-md-center flex-grow-1 py-4">
