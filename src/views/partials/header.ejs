<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Quality - Sistema de Pedidos' %></title>

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Estilos propios -->
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light">

  <!-- ================= HEADER ================= -->
  <header class="navbar navbar-dark bg-primary shadow-sm">
    <!-- 🔑 MISMO CONTENEDOR que el body -->
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center py-2">

      <!-- Logo + enlace dinámico -->
      <a
        class="navbar-brand d-flex align-items-center gap-2"
        href="<%= currentUser && currentUser.role === 'admin' ? '/admin' : '/empleado/pedidos/nuevo' %>"
      >
        <img
          src="/img/quality.png"
          alt="Quality"
          width="32"
          height="32"
          class="rounded-circle bg-white p-1"
        />
        <span class="fw-semibold">Quality · Sistema de Pedidos</span>
      </a>

      <%
        // Texto base del "módulo"
        let subtitleLabel;
        if (typeof headerSubtitle !== 'undefined' && headerSubtitle) {
          subtitleLabel = headerSubtitle;
        } else if (currentUser && currentUser.role === 'admin') {
          subtitleLabel = 'Módulo administrador';
        } else if (currentUser && currentUser.role === 'empleado') {
          subtitleLabel = 'Módulo empleado';
        } else {
          subtitleLabel = 'Sistema de pedidos';
        }
      %>

      <!-- Lado derecho -->
      <div class="d-flex align-items-center gap-3">

        <% if (currentUser) { %>
          <div class="dropdown">
            <button
              class="btn btn-outline-light btn-sm dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <%= subtitleLabel %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <a class="dropdown-item" href="/auth/logout">
                  Cerrar sesión
                </a>
              </li>
            </ul>
          </div>
        <% } else { %>
          <span class="navbar-text text-white-50 small">
            <%= subtitleLabel %>
          </span>
        <% } %>

      </div>
    </div>
  </header>
  <!-- ================= FIN HEADER ================= -->

  <!-- MAIN -->
  <main class="flex-grow-1 py-4">
  <div class="container-fluid px-4 admin-container">
