<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= title %> - Quality</title>

  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Estilos del login -->
  <link rel="stylesheet" href="/css/login.css" />

  <!-- ⭐ ESTILOS EXTRA PARA AGRANDAR TODO -->
  <style>
    /* Aumentar tamaño del texto en el formulario */
    .login-card * {
      font-size: 1.05rem;
    }

    /* Inputs más altos y con texto más visible */
    .login-card .form-control {
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
    }

    /* Botón más grande */
    .login-card .btn-primary {
      padding: 0.75rem;
      font-size: 1.1rem;
      font-weight: 500;
      border-radius: 10px;
    }

    /* ⭐ Logos dentro del login */
    .login-logos-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.3rem;
    }

    .login-logo {
      object-fit: contain;
    }

    /* 🔹 Logo Quality */
    #logo-quality {
      max-height: 60px;
      max-width: 120px;
    }

    /* 🔹 Logo Cadetek */
    #logo-cadetek {
      max-height: 90px;
      max-width: 130px;
    }

    /* Móvil */
    @media (max-width: 576px) {
      .login-logos-wrapper {
        justify-content: center;
        gap: 2rem;
      }

      #logo-quality {
        max-height: 60px;
      }

      #logo-cadetek {
        max-height: 55px;
      }
    }

    /* Reduce el padding superior del header dentro del login */
    .login-card .card-header {
      padding-top: 0.2rem !important;
      padding-bottom: 0.5rem !important;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <%- include('../partials/header', { 
    title: 'Login',
    headerSubtitle: 'Acceso al sistema interno de pedidos.'
  }) %>

  <!-- ⭐ Usa el main abierto por el header -->
  <div class="container my-5 flex-grow-1">
    <div class="row justify-content-center">

      <!-- ⭐ LOGIN MÁS ANCHO -->
      <div class="col-12 col-sm-10 col-md-9 col-lg-7 col-xl-6">

        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            Usuario o contraseña incorrectos.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
          </div>
        <% } %>

        <% if (expired) { %>
          <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
            La sesión ha expirado. Por favor, inicie sesión de nuevo.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
          </div>
        <% } %>

        <!-- ⭐ CARD MÁS ALTO Y CON ESTILOS DE TEXTO -->
        <div class="card shadow-sm border-0 login-card p-4 p-md-5">

          <div class="card-header bg-white border-0 pb-0">
            <!-- 🔹 Logos de las dos empresas -->
            <div class="login-logos-wrapper">
              <img
                id="logo-quality"
                src="/img/quality.png"
                alt="Logo Quality"
                class="login-logo"
              >
              <img
                id="logo-cadetek"
                src="/img/cadetek_logo1.png"
                alt="Logo Cadetek"
                class="login-logo"
              >
            </div>

            <!-- ⭐ Título centrado -->
            <h1 class="h3 mb-2 text-center">Login</h1>
          </div>

          <div class="card-body">

            <form action="/auth/login" method="POST" novalidate>

              <!-- Usuario -->
              <div class="mb-4">
                <label for="usuario" class="form-label fw-semibold">Usuario</label>
                <input
                  type="text"
                  class="form-control"
                  id="usuario"
                  name="usuario"
                  required
                  placeholder="Ingrese el usuario"
                  autocomplete="username"
                />
                
              </div>

              <!-- Contraseña -->
              <div class="mb-4">
                <label for="password" class="form-label fw-semibold">Contraseña</label>
                <input
                  type="password"
                  class="form-control"
                  id="password"
                  name="password"
                  required
                  placeholder="••••••••"
                  autocomplete="current-password"
                />
              </div>

              <!-- Botón -->
              <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary">
                  Entrar
                </button>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- (Opcional) autofocus al usuario -->
  <script>
    const u = document.getElementById('usuario');
    if (u) u.focus();
  </script>
</body>
</html>
