<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= title %> - Quality</title>

  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Estilos del login -->
  <link rel="stylesheet" href="/css/login.css" />

  <!-- ⭐ ESTILOS EXTRA PARA AGRANDAR TODO -->
  <style>
    /* Aumentar tamaño del texto en el formulario */
    .login-card * {
      font-size: 1.05rem;
    }

    /* Inputs más altos y con texto más visible */
    .login-card .form-control {
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
    }

    /* Botón más grande */
    .login-card .btn-primary {
      padding: 0.75rem;
      font-size: 1.1rem;
      font-weight: 500;
      border-radius: 10px;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <%- include('../partials/header', { 
    title: 'Login',
    headerSubtitle: 'Acceso al sistema interno de pedidos.'
  }) %>

  <!-- ⭐ Usa el main abierto por el header -->
  <div class="container my-5 flex-grow-1">
    <div class="row justify-content-center">

      <!-- ⭐ LOGIN MÁS ANCHO → AQUÍ SE CAMBIÓ -->
      <!-- Antes: col-md-6 col-lg-4 -->
      <!-- Ahora: más ancho en tablets y laptops -->
      <div class="col-12 col-sm-10 col-md-9 col-lg-7 col-xl-6">

        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            Usuario o contraseña incorrectos.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
          </div>
        <% } %>

        <% if (expired) { %>
          <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
            La sesión ha expirado. Por favor, inicie sesión de nuevo.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
          </div>
        <% } %>

        <!-- ⭐ CARD MÁS ALTO Y CON ESTILOS DE TEXTO -->
        <div class="card shadow-sm border-0 login-card p-4 p-md-5">

          <div class="card-header bg-white border-0 pb-0 text-center">
            <!-- ⭐ Título más grande -->
            <h1 class="h3 mb-2">Login</h1>
          </div>

          <div class="card-body">

            <form action="/auth/login" method="POST" novalidate>

              <!-- Correo -->
              <div class="mb-4">
                <label for="email" class="form-label fw-semibold">Correo</label>
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  required
                  value="empleado@quality.com"
                />
              </div>

              <!-- Contraseña -->
              <div class="mb-4">
                <label for="password" class="form-label fw-semibold">Contraseña</label>
                <input
                  type="password"
                  class="form-control"
                  id="password"
                  name="password"
                  required
                  placeholder="••••••••"
                />
              </div>

              <!-- Botón -->
              <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary">
                  Entrar
                </button>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
