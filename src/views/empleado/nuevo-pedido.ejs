<script>
  // ✅ VALIDACIÓN RELACIÓN: anticipo <= total (SIN TOASTS)
  function validarRelacionTotales() {
    const totalEl = document.getElementById('total');
    const anticipoEl = document.getElementById('anticipo');
    const restoEl = document.getElementById('resto_preview');
    const feedback = document.getElementById('anticipoFeedback');

    if (!totalEl || !anticipoEl || !restoEl) return true;

    totalEl.setCustomValidity('');
    anticipoEl.setCustomValidity('');
    restoEl.setCustomValidity('');
    if (feedback) feedback.textContent = 'Ingresa el anticipo.';

    const tRaw = totalEl.value;
    const aRaw = anticipoEl.value;

    if (tRaw === '' || aRaw === '') return true;

    const total = Number(tRaw);
    const anticipo = Number(aRaw);

    if (Number.isNaN(total) || Number.isNaN(anticipo)) return true;

    if (total < 0 || anticipo < 0) {
      anticipoEl.setCustomValidity('Monto inválido');
      if (feedback) feedback.textContent = 'El monto debe ser positivo.';
      return false;
    }

    if (anticipo > total) {
      const msg = 'El anticipo no puede ser mayor al total.';
      anticipoEl.setCustomValidity(msg);
      restoEl.setCustomValidity('Resto inválido');
      if (feedback) feedback.textContent = msg;
      return false;
    }

    return true;
  }
</script>

<script>
  // ================================
  // ✅ ITEMS (tabla partidas)
  // ================================
  function money2(n) {
    const num = Number(n);
    if (!Number.isFinite(num)) return 0;
    return Math.round(num * 100) / 100;
  }

  function buildEmptyRow(item = {}) {
    const tr = document.createElement('tr');

    tr.innerHTML = `
      <td>
        <input type="number" class="form-control form-control-sm item-cant" min="1" step="1" value="${item.cantidad ?? ''}" placeholder="1" required>
      </td>
      <td>
        <input type="text" class="form-control form-control-sm item-desc" value="${item.descripcion ?? ''}" placeholder="Ej: 3 camisas" required>
      </td>
      <td>
        <input type="number" class="form-control form-control-sm item-total" min="0" step="0.01" value="${item.total ?? ''}" placeholder="0.00" required>
      </td>
      <td class="text-end">
        <button type="button" class="btn btn-outline-danger btn-sm item-del" title="Eliminar">✕</button>
      </td>
    `;

    tr.querySelectorAll('input').forEach(inp => {
      inp.addEventListener('input', () => {
        syncItemsToHidden();
        recalcTotalFromItems();
        try { setDraft(readFormValues()); } catch {}
      });
      inp.addEventListener('change', () => {
        syncItemsToHidden();
        recalcTotalFromItems();
        try { setDraft(readFormValues()); } catch {}
      });
    });

    tr.querySelector('.item-del').addEventListener('click', () => {
      tr.remove();
      ensureAtLeastOneRow();
      syncItemsToHidden();
      recalcTotalFromItems();
      try { setDraft(readFormValues()); } catch {}
    });

    return tr;
  }

  function getItemsFromTable() {
    const rows = Array.from(document.querySelectorAll('#itemsTbody tr'));
    const items = [];

    rows.forEach(r => {
      const cant = Number(r.querySelector('.item-cant')?.value ?? '');
      const desc = (r.querySelector('.item-desc')?.value ?? '').trim();
      const tot = Number(r.querySelector('.item-total')?.value ?? '');

      if (!desc && (!Number.isFinite(cant) || !Number.isFinite(tot))) return;

      items.push({
        cantidad: Number.isFinite(cant) ? cant : null,
        descripcion: desc || null,
        total: Number.isFinite(tot) ? money2(tot) : null
      });
    });

    return items;
  }

  function makeDescripcionFromItems(items) {
    const lines = (items || [])
      .filter(i => i && i.cantidad && i.descripcion && Number.isFinite(Number(i.total)))
      .map((i, idx) => `${idx + 1}) (${i.cantidad}) ${i.descripcion} — $${money2(i.total).toFixed(2)}`);
    return lines.join('\n');
  }

  function syncItemsToHidden() {
    const items = getItemsFromTable();
    const itemsJsonEl = document.getElementById('items_json');
    const descHiddenEl = document.getElementById('descripcion_pedido');

    if (itemsJsonEl) itemsJsonEl.value = JSON.stringify(items);
    if (descHiddenEl) descHiddenEl.value = makeDescripcionFromItems(items);
  }

  function recalcTotalFromItems() {
    const items = getItemsFromTable();
    const sum = items.reduce((acc, i) => {
      const t = Number(i?.total);
      return acc + (Number.isFinite(t) ? t : 0);
    }, 0);

    const totalEl = document.getElementById('total');
    if (totalEl) totalEl.value = money2(sum).toFixed(2);

    try { if (typeof calcularResto === 'function') calcularResto(); } catch {}
    try { if (typeof validarRelacionTotales === 'function') validarRelacionTotales(); } catch {}
  }

  function ensureAtLeastOneRow() {
    const tbody = document.getElementById('itemsTbody');
    if (!tbody) return;
    if (tbody.querySelectorAll('tr').length === 0) {
      tbody.appendChild(buildEmptyRow());
    }
  }

  function validateItemsHard() {
    const items = getItemsFromTable()
      .filter(i => i && i.cantidad && i.descripcion && Number.isFinite(Number(i.total)));
    const ok = items.length > 0;

    const fb = document.getElementById('itemsFeedback');
    if (fb) fb.style.display = ok ? 'none' : 'block';

    return ok;
  }

  function setItemsToTable(items = []) {
    const tbody = document.getElementById('itemsTbody');
    if (!tbody) return;

    tbody.innerHTML = '';
    (items || []).forEach(it => tbody.appendChild(buildEmptyRow(it)));
    ensureAtLeastOneRow();
    syncItemsToHidden();
    recalcTotalFromItems();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const tbody = document.getElementById('itemsTbody');
    const btnAdd = document.getElementById('btnAddItem');

    if (!tbody || !btnAdd) return;

    ensureAtLeastOneRow();
    syncItemsToHidden();
    recalcTotalFromItems();

    btnAdd.addEventListener('click', () => {
      tbody.appendChild(buildEmptyRow());
      syncItemsToHidden();
      recalcTotalFromItems();
      try { setDraft(readFormValues()); } catch {}
    });

    const form = document.querySelector('form.needs-validation');
    if (form) {
      form.addEventListener('submit', (e) => {
        const okItems = validateItemsHard();
        if (!okItems) {
          e.preventDefault();
          e.stopPropagation();
          form.classList.add('was-validated');
          document.getElementById('itemsTable')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, true);
    }
  });
</script>

