<%- include('../partials/header', { 
  title: 'Nuevo pedido - Empleado',
  headerSubtitle: 'Módulo empleado'
}) %>

<style>
  /* =========================
     ALERTA "BARRA" ARRIBA (bonita)
     ========================= */
  .top-banner {
    position: sticky;
    top: 10px;
    z-index: 1055;
  }

  /* Panel extras */
  .extra-panel {
    border: 1px solid #e6e6e6;
    border-radius: 14px;
    padding: 14px;
    background: #f8f9fa;
    transition: opacity .15s ease;
  }
  .extra-panel.is-disabled {
    opacity: .45;
  }

  /* Barrita arriba de botones para el switch */
  .toggle-bar {
    border: 1px solid #e6e6e6;
    border-radius: 14px;
    padding: 10px 12px;
    background: #fff;
  }

  /* ✅ ANCHO INTERNO DEL FORM (pantalla) */
  .form-inner{
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-11 col-md-9 col-lg-7 col-xl-6">

      <!-- ✅ MODAL ÉXITO (se abre cuando success=1) -->
      <% if (success) { %>
        <div class="modal fade" id="successPedidoModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
              <div class="modal-header">
                <h5 class="modal-title">Pedido registrado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>

              <div class="modal-body">
                <p class="mb-2">
                  <strong>¡Pedido registrado con éxito!</strong>
                </p>

                <% if (folio) { %>
                  <p class="mb-0">
                    Folio asignado: <strong><%= folio %></strong>
                  </p>
                <% } else { %>
                  <p class="mb-0 text-muted small">Folio asignado correctamente.</p>
                <% } %>

                <hr class="my-3">

                <% if (typeof pedidoId !== 'undefined' && pedidoId && String(pedidoId).trim() !== '') { %>
                <p class="text-muted small mb-2">
                  PDF oficial listo (con folio real).
                </p>

                <div class="d-grid gap-2">
                  <!-- ✅ ahora lo interceptamos con JS para mostrar modal "generando" -->
                  <a class="btn btn-outline-primary js-open-pdf"
                    href="/pedidos/pdf/<%= pedidoId %>">
                    Imprimir/Descargar PDF
                  </a>
                </div>
              <% } else { %>
                <p class="text-muted small mb-0">
                  No se detectó el <strong>ID del pedido</strong> para generar el PDF oficial.
                  Asegúrate de redirigir con <code>&pedidoId=...</code>.
                </p>
              <% } %>


              </div>

              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                  Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnSuccessNuevo">
                  Nuevo pedido
                </button>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <div class="card shadow-sm border-0" id="print-area">
        <div class="card-header bg-white border-0 pb-0">
          <h1 class="h4 text-center mb-1">Registrar pedido</h1>
          <p class="text-muted text-center small mb-3">
            Llena los datos del cliente y del pedido. El estado inicial será
            <strong>No iniciado</strong>.
          </p>
        </div>

        <div class="card-body">
          <form method="POST" action="/pedidos" class="needs-validation" novalidate>

            <div class="form-inner">

              <div class="mb-3">
                <label for="folio_preview" class="form-label">Folio</label>
                <input type="text" class="form-control" id="folio_preview" name="folio_preview" readonly />
                <div class="form-text">El folio se asigna automáticamente al guardar.</div>
              </div>

              <div class="row g-3">
                <div class="col-12">

                  <div class="mb-3">
                    <label for="nombre_cliente" class="form-label">Nombre del cliente</label>
                    <input type="text" class="form-control" id="nombre_cliente" name="nombre_cliente" required />
                    <div class="invalid-feedback">Por favor ingresa el nombre del cliente.</div>
                  </div>

                  <div class="mb-3">
                    <label for="telefono_cliente" class="form-label">Teléfono del cliente</label>
                    <input
                      type="text"
                      class="form-control"
                      id="telefono_cliente"
                      name="telefono_cliente"
                      required
                      inputmode="numeric"
                      autocomplete="tel"
                      maxlength="10"
                      pattern="[0-9]{10}"
                    />
                    <div class="invalid-feedback">Ingresa un teléfono de 10 dígitos.</div>
                  </div>

                  <!-- =======================================
                       ✅ PARTIDAS (reemplaza textarea)
                       - descripcion_pedido sigue existiendo (hidden)
                       - items_json es el payload real
                       ======================================= -->
                  <div class="mb-3">
                    <label class="form-label">Partidas del pedido</label>

                    <!-- ✅ compatibilidad con backend actual (required en controller/service) -->
                    <input type="hidden" id="descripcion_pedido" name="descripcion_pedido" value="" />

                    <!-- ✅ payload real -->
                    <input type="hidden" id="items_json" name="items_json" value="[]" />

                    <div class="table-responsive">
                      <table class="table table-sm align-middle mb-2" id="itemsTable">
                        <thead class="table-light">
                          <tr>
                            <th style="width: 90px;">Cant.</th>
                            <th>Descripción</th>
                            <th style="width: 140px;">Total</th>
                            <th style="width: 60px;"></th>
                          </tr>
                        </thead>
                        <tbody id="itemsTbody">
                          <!-- filas por JS -->
                        </tbody>
                      </table>
                    </div>

                    <div class="d-flex gap-2">
                      <button type="button" class="btn btn-outline-secondary btn-sm" id="btnAddItem">
                        + Agregar fila
                      </button>
                      <small class="text-muted align-self-center">
                        El total del pedido se calcula automáticamente con la suma de las partidas.
                      </small>
                    </div>

                    <div class="invalid-feedback d-block" id="itemsFeedback" style="display:none;">
                      Agrega al menos una partida válida.
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="sucursal" class="form-label">Sucursal</label>
                    <select class="form-select" id="sucursal" name="sucursal" required>
                      <option value="" selected disabled>Selecciona una sucursal</option>
                      <option value="Plazuela">Plazuela</option>
                      <option value="Centro">Centro</option>
                      <option value="López">López</option>
                    </select>
                    <div class="invalid-feedback">Selecciona la sucursal correspondiente.</div>
                  </div>

                  <div class="mb-3">
                    <label for="fecha_entrega" class="form-label">Fecha de entrega</label>
                    <input type="date" class="form-control" id="fecha_entrega" name="fecha_entrega" required />
                    <div class="invalid-feedback">Selecciona una fecha de entrega.</div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">¿Requiere factura?</label>
                    <div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="requiere_factura" value="si">
                        <label class="form-check-label">Sí</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="requiere_factura" value="no" checked>
                        <label class="form-check-label">No</label>
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="total" class="form-label">Total ($)</label>
                    <!-- ✅ ahora lo calcula la tabla -->
                    <input type="number" class="form-control" id="total" name="total" step="0.01" min="0" inputmode="decimal" required readonly>
                    <div class="invalid-feedback">Ingresa el total.</div>
                  </div>

                  <div class="mb-3">
                    <label for="anticipo" class="form-label">Anticipo ($)</label>
                    <input type="number" class="form-control" id="anticipo" name="anticipo" step="0.01" min="0" inputmode="decimal" required>
                    <div class="invalid-feedback" id="anticipoFeedback">Ingresa el anticipo.</div>
                  </div>

                  <div class="mb-3">
                    <label for="resto_preview" class="form-label">Resto ($)</label>
                    <input type="number" class="form-control" id="resto_preview" name="resto_preview" readonly required>
                    <div class="invalid-feedback">El resto no puede quedar vacío.</div>
                  </div>

                  <div class="mb-3">
                    <label for="encargado" class="form-label">Encargado de realizar el trabajo</label>
                    <input type="text" class="form-control" id="encargado" name="encargado" placeholder="Nombre de quien hará el trabajo" required />
                    <div class="invalid-feedback">Ingresa el encargado.</div>
                  </div>

                  <div class="mb-3">
                    <label for="recibe" class="form-label">Nombre de quien recibe </label>
                    <input type="text" class="form-control" id="recibe" name="recibe"
                      placeholder="Nombre de la persona que recogerá el pedido" required />
                    <div class="invalid-feedback">Ingresa el nombre de quien recibe.</div>

                  </div>

                </div>

                <div class="toggle-bar mt-3">
                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small text-muted">
                      Datos de impresión / archivo <span class="text-muted">(solo si aplica)</span>
                    </div>

                    <div class="form-check form-switch m-0">
                      <input class="form-check-input" type="checkbox" id="toggleExtra" name="toggleExtra" value="1">
                      <label class="form-check-label" for="toggleExtra">
                        Activar
                      </label>
                    </div>
                  </div>
                </div>

              </div>

              <div class="extra-panel is-disabled mt-3" id="extraPanel">
                <h6 class="mb-2">Trabajo</h6>

                <div class="mb-3 d-flex gap-4 flex-wrap">
                  <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="trabajo_impreso" name="trabajo_impreso" value="true" disabled>
                    <span class="form-check-label">Trabajo impreso</span>
                  </label>

                  <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="trabajo_entregado" name="trabajo_entregado" value="true" disabled>
                    <span class="form-check-label">Trabajo entregado</span>
                  </label>
                </div>

                <div class="mb-3">
                  <label for="observaciones" class="form-label">Observaciones</label>
                  <textarea class="form-control" id="observaciones" name="observaciones" rows="3" placeholder="Notas adicionales del trabajo..." disabled></textarea>
                </div>

                <h6 class="mb-2">¿Dónde se guardó el archivo?</h6>

                <div class="mb-2">
                  <label for="archivo_carpeta" class="form-label">Carpeta</label>
                  <input class="form-control" id="archivo_carpeta" name="archivo_carpeta" placeholder="Ej: Quality/Dic-2025" disabled>
                </div>

                <div class="mb-2">
                  <label for="archivo_nombre" class="form-label">Nombre del archivo</label>
                  <input class="form-control" id="archivo_nombre" name="archivo_nombre" placeholder="Ej: Pedido_045.pdf" disabled>
                </div>

                <div class="mb-0">
                  <label for="archivo_computadora" class="form-label">Computadora</label>
                  <input class="form-control" id="archivo_computadora" name="archivo_computadora" placeholder="Ej: PC-Centro-02" disabled>
                </div>
              </div>

              <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Registrar pedido</button>
              </div>

              <p class="text-muted small text-center mt-3 mb-0">
                La fecha del pedido y el estado inicial (<strong>No iniciado</strong>) se generan automáticamente.
              </p>

            </div>
          </form>

          <!-- ✅ MODAL CONFIRMACIÓN -->
          <div class="modal fade" id="confirmPedidoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content border-0 shadow">
                <div class="modal-header">
                  <h5 class="modal-title">Confirmar pedido</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                  <p class="text-muted small mb-3">
                    Revisa la información antes de guardar. Puedes cerrar con la <strong>X</strong> para editar o generar el PDF.
                  </p>

                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <tbody>
                        <tr>
                          <th class="text-nowrap" style="width: 190px;">Folio (previo)</th>
                          <td><strong id="conf_folio">—</strong></td>
                        </tr>
                        <tr><th>Cliente</th><td id="conf_cliente">—</td></tr>
                        <tr><th>Teléfono</th><td id="conf_tel">—</td></tr>
                        <tr><th>Sucursal</th><td id="conf_sucursal">—</td></tr>
                        <tr><th>Entrega</th><td id="conf_entrega">—</td></tr>
                        <tr><th>Factura</th><td id="conf_factura">—</td></tr>
                        <tr><th>Total / Anticipo / Resto</th><td id="conf_montos">—</td></tr>
                        <tr><th>Encargado</th><td id="conf_encargado">—</td></tr>
                        <tr><th>Recibe</th><td id="conf_recibe">—</td></tr>

                        <!-- ✅ ahora muestra partidas -->
                        <tr><th>Partidas</th><td id="conf_desc" style="white-space:pre-wrap;">—</td></tr>

                        <tr class="table-light" id="extrasHeaderRow">
                          <th colspan="2" class="small text-muted">Extras (solo si aplica)</th>
                        </tr>
                        <tr class="extras-row"><th>Trabajo impreso</th><td id="conf_impreso">—</td></tr>
                        <tr class="extras-row"><th>Trabajo entregado</th><td id="conf_entregado">—</td></tr>
                        <tr class="extras-row"><th>Observaciones</th><td id="conf_obs">—</td></tr>
                        <tr class="extras-row"><th>Carpeta</th><td id="conf_carpeta">—</td></tr>
                        <tr class="extras-row"><th>Archivo</th><td id="conf_archivo">—</td></tr>
                        <tr class="extras-row"><th>Computadora</th><td id="conf_pc">—</td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="modal-footer">
                  

                  <button type="button" class="btn btn-primary" id="btnModalGuardar">
                    Aceptar y guardar
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- ✅ FORM OCULTO: genera el PDF preview real en nueva pestaña -->
          <form id="pdfPreviewForm" method="POST" action="/pedidos/pdf/preview" target="_blank" style="display:none;"></form>

        </div>
      </div>

    </div>
  </div>
</div>

<script>
function abrirPdfEnOtraPestaña(url) {
  // 🔥 popup DIRECTO desde el click
  const pdfTab = window.open('about:blank', '_blank');
  if (!pdfTab) {
    alert('El navegador bloqueó la pestaña del PDF. Activa popups para este sitio.');
    return;
  }

  try {
    pdfTab.document.open();
    pdfTab.document.write(`
      <!doctype html>
      <html lang="es">
      <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Generando PDF…</title>
        <style>
          html,body{
            height:100%;
            margin:0;
          }
          body{
            font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;
            display:flex;
            align-items:center;
            justify-content:center;
            background:#fff;
            padding:16px;
          }
          .box{
            width:100%;
            max-width:420px;
            display:flex;
            flex-direction:column;
            align-items:center;
            gap:18px;
            padding:28px 24px;
            border:1px solid #eee;
            border-radius:18px;
            box-shadow:0 12px 32px rgba(0,0,0,.12);
            text-align:center;
          }
          .spin{
            width:56px;
            height:56px;
            border:5px solid #ddd;
            border-top-color:#111;
            border-radius:50%;
            animation:spin 1s linear infinite;
          }
          @keyframes spin{to{transform:rotate(360deg)}}
          .t1{
            font-weight:800;
            font-size:20px;
          }
          .t2{
            font-size:15px;
            color:#666;
            line-height:1.4;
          }
        </style>
      </head>
      <body>
        <div class="box">
          <div class="spin"></div>
          <div class="t1">Se está generando el PDF…</div>
          <div class="t2">Espere un momento, puede tardar unos segundos.</div>
        </div>
      </body>
      </html>
    `);
    pdfTab.document.close();
  } catch {}

  // 🚀 Navega al PDF (MISMA pestaña)
  pdfTab.location.href = url;
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('a.js-open-pdf').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      abrirPdfEnOtraPestaña(a.getAttribute('href'));
    });
  });
});
</script>



<script>
  function showPdfLoader() {
    if (document.getElementById('pdf-loader-overlay')) return;

    const overlay = document.createElement('div');
    overlay.id = 'pdf-loader-overlay';
    overlay.innerHTML = `
      <div class="pdf-loader-box">
        <div class="pdf-loader-spin" aria-hidden="true"></div>
        <div>
          <div class="pdf-loader-t1">Se está generando el PDF…</div>
          <div class="pdf-loader-t2">Espere un momento, puede tardar unos segundos.</div>
        </div>
      </div>
    `;

    const style = document.createElement('style');
    style.id = 'pdf-loader-style';
    style.textContent = `
      #pdf-loader-overlay{
        position:fixed; inset:0;
        background:rgba(255,255,255,.92);
        display:flex;
        align-items:center;
        justify-content:center;
        padding:16px;
        z-index:99999;
      }
      .pdf-loader-box{
        width:min(520px, 100%);
        display:flex;
        gap:16px;
        align-items:center;
        justify-content:center;
        padding:22px 22px;
        border:1px solid #eee;
        border-radius:16px;
        box-shadow:0 10px 28px rgba(0,0,0,.10);
        background:#fff;
      }
      .pdf-loader-spin{
        width:28px;height:28px;
        border:4px solid #ddd;
        border-top-color:#111;
        border-radius:50%;
        animation:pdfspin 1s linear infinite;
        flex-shrink:0;
      }
      @keyframes pdfspin{to{transform:rotate(360deg)}}
      .pdf-loader-t1{font-weight:800;font-size:16px;text-align:center;}
      .pdf-loader-t2{font-size:13px;color:#666;margin-top:4px;text-align:center;line-height:1.35;}

      @media (max-width: 768px){
        .pdf-loader-box{padding:28px 22px;gap:18px;flex-direction:column;}
        .pdf-loader-spin{width:52px;height:52px;border-width:5px;}
        .pdf-loader-t1{font-size:20px;}
        .pdf-loader-t2{font-size:15px;}
      }
    `;

    document.head.appendChild(style);
    document.body.appendChild(overlay);
  }

  function hidePdfLoader() {
    document.getElementById('pdf-loader-overlay')?.remove();
    document.getElementById('pdf-loader-style')?.remove();
  }

  function abrirPdfEnOtraPestaña(url) {
    showPdfLoader();

    const tab = window.open(url, '_blank');
    if (!tab) {
      hidePdfLoader();
      alert('El navegador bloqueó la pestaña del PDF. Activa popups para este sitio.');
      return;
    }

    // quita loader cuando regreses a esta pestaña
    const onVis = () => {
      if (!document.hidden) {
        hidePdfLoader();
        document.removeEventListener('visibilitychange', onVis);
      }
    };
    document.addEventListener('visibilitychange', onVis);

    // fallback por si no cambia visibilidad
    setTimeout(hidePdfLoader, 6000);
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a.js-open-pdf').forEach(a => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        abrirPdfEnOtraPestaña(a.getAttribute('href'));
      });
    });
  });
</script>


