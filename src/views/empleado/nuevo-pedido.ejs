<script>
  // =========================================
  // ✅ 1) VALIDACIÓN + MODAL CONFIRM
  // =========================================
  window.addEventListener('load', () => {
    'use strict';

    const form = document.querySelector('form.needs-validation');
    if (!form) return;

    const modalEl = document.getElementById('confirmPedidoModal');

    if (!modalEl || !window.bootstrap || !bootstrap.Modal) {
      console.warn('⚠️ Bootstrap Modal no está disponible. Revisa tu footer (bootstrap.bundle).');
      return;
    }

    const modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
    let bypassConfirm = false;

    function fmtMoney(v) {
      const n = parseFloat(v);
      if (Number.isNaN(n)) return '—';
      return '$' + n.toFixed(2);
    }

    function fmtDateISO(iso) {
      if (!iso) return '—';
      const parts = String(iso).split('-');
      if (parts.length !== 3) return iso;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function setText(id, val) {
      const el = document.getElementById(id);
      if (el) el.textContent = (val && String(val).trim() !== '') ? val : '—';
    }

    function isMeaningfulText(v) {
      if (v == null) return false;
      const s = String(v).trim();
      return s !== '' && s !== '—';
    }

    function fillConfirmModal() {
      const folio = document.getElementById('folio_preview')?.value || '';
      const nombre = document.getElementById('nombre_cliente')?.value || '';
      const tel = document.getElementById('telefono_cliente')?.value || '';
      const suc = document.getElementById('sucursal')?.value || '';
      const fecha = document.getElementById('fecha_entrega')?.value || '';

      const total = document.getElementById('total')?.value || '';
      const anticipo = document.getElementById('anticipo')?.value || '';
      const resto = document.getElementById('resto_preview')?.value || '';
      const encargado = document.getElementById('encargado')?.value || '';
      const recibe = document.getElementById('recibe')?.value || '';

      const factura = document.querySelector('input[name="requiere_factura"]:checked')?.value || 'no';

      const toggleExtra = document.getElementById('toggleExtra')?.checked || false;
      const impreso = document.getElementById('trabajo_impreso')?.checked || false;
      const entregado = document.getElementById('trabajo_entregado')?.checked || false;
      const obs = document.getElementById('observaciones')?.value || '';
      const carpeta = document.getElementById('archivo_carpeta')?.value || '';
      const archivo = document.getElementById('archivo_nombre')?.value || '';
      const pc = document.getElementById('archivo_computadora')?.value || '';

      setText('conf_folio', folio);
      setText('conf_cliente', nombre);
      setText('conf_tel', tel);
      setText('conf_sucursal', suc);
      setText('conf_entrega', fmtDateISO(fecha));
      setText('conf_factura', (factura === 'si') ? 'Sí' : 'No');
      setText('conf_montos', `${fmtMoney(total)} / ${fmtMoney(anticipo)} / ${fmtMoney(resto)}`);
      setText('conf_encargado', encargado);
      setText('conf_recibe', recibe);

      const itemsJson = document.getElementById('items_json')?.value || '[]';
      let items = [];
      try { items = JSON.parse(itemsJson); } catch {}

      const pretty = (items || [])
        .filter(i => i && i.cantidad && i.descripcion && Number.isFinite(Number(i.total)))
        .map((i, idx) => `${idx + 1}) (${i.cantidad}) ${i.descripcion} — $${Number(i.total).toFixed(2)}`)
        .join('\n');

      setText('conf_desc', pretty || '—');

      if (!toggleExtra) {
        setText('conf_impreso', '—');
        setText('conf_entregado', '—');
        setText('conf_obs', '—');
        setText('conf_carpeta', '—');
        setText('conf_archivo', '—');
        setText('conf_pc', '—');
      } else {
        setText('conf_impreso', impreso ? 'Sí' : 'No');
        setText('conf_entregado', entregado ? 'Sí' : 'No');
        setText('conf_obs', obs);
        setText('conf_carpeta', carpeta);
        setText('conf_archivo', archivo);
        setText('conf_pc', pc);
      }

      const hasExtrasData =
        (impreso === true) ||
        (entregado === true) ||
        isMeaningfulText(obs) ||
        isMeaningfulText(carpeta) ||
        isMeaningfulText(archivo) ||
        isMeaningfulText(pc);

      const shouldShowExtras = toggleExtra && hasExtrasData;

      const headerRow = document.getElementById('extrasHeaderRow');
      const extrasRows = modalEl.querySelectorAll('.extras-row');

      if (!shouldShowExtras) {
        if (headerRow) headerRow.style.display = 'none';
        extrasRows.forEach(r => r.style.display = 'none');
      } else {
        if (headerRow) headerRow.style.display = '';
        extrasRows.forEach(r => r.style.display = '');
      }
    }

    document.getElementById('btnModalImprimir')?.addEventListener('click', () => {
      submitPdfPreview();
    });

    document.getElementById('btnModalGuardar')?.addEventListener('click', () => {
      bypassConfirm = true;
      try { modal.hide(); } catch {}
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.submit();
    });

    form.addEventListener('submit', (event) => {
      try { if (typeof calcularResto === 'function') calcularResto(); } catch {}

      const okRel = validarRelacionTotales();

      if (bypassConfirm) return;

      const okItems = (typeof validateItemsHard === 'function') ? validateItemsHard() : true;

      if (!okRel || !okItems || !form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();

        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalid.focus({ preventScroll: true });
        }
        form.classList.add('was-validated');
        return;
      }

      event.preventDefault();
      event.stopPropagation();

      form.classList.add('was-validated');
      fillConfirmModal();
      modal.show();
    }, false);
  });
</script>

<script>
  const DRAFT_KEY = 'quality_nuevo_pedido_draft_v1';

  function getDraft() {
    try { return JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}'); }
    catch { return {}; }
  }

  function setDraft(obj) {
    try { localStorage.setItem(DRAFT_KEY, JSON.stringify(obj || {})); } catch {}
  }

  function clearDraft() {
    try { localStorage.removeItem(DRAFT_KEY); } catch {}
  }

  function readFormValues() {
    const data = {};

    const nombre = document.getElementById('nombre_cliente');
    const tel = document.getElementById('telefono_cliente');
    const itemsJson = document.getElementById('items_json');
    const suc = document.getElementById('sucursal');
    const fecha = document.getElementById('fecha_entrega');
    const total = document.getElementById('total');
    const anticipo = document.getElementById('anticipo');
    const encargado = document.getElementById('encargado');
    const recibe = document.getElementById('recibe');

    const toggleExtra = document.getElementById('toggleExtra');

    const obs = document.getElementById('observaciones');
    const imp = document.getElementById('trabajo_impreso');
    const ent = document.getElementById('trabajo_entregado');
    const car = document.getElementById('archivo_carpeta');
    const nom = document.getElementById('archivo_nombre');
    const pc  = document.getElementById('archivo_computadora');

    const facturaSi = document.querySelector('input[name="requiere_factura"][value="si"]');
    const facturaNo = document.querySelector('input[name="requiere_factura"][value="no"]');

    if (nombre) data.nombre_cliente = nombre.value;
    if (tel) data.telefono_cliente = tel.value;

    if (itemsJson) data.items_json = itemsJson.value;

    if (suc) data.sucursal = suc.value;
    if (fecha) data.fecha_entrega = fecha.value;
    if (total) data.total = total.value;
    if (anticipo) data.anticipo = anticipo.value;
    if (encargado) data.encargado = encargado.value;
    if (recibe) data.recibe = recibe.value;

    if (facturaSi && facturaNo) data.requiere_factura = facturaSi.checked ? 'si' : 'no';
    if (toggleExtra) data.toggleExtra = toggleExtra.checked;

    if (obs) data.observaciones = obs.value;
    if (imp) data.trabajo_impreso = !!imp.checked;
    if (ent) data.trabajo_entregado = !!ent.checked;
    if (car) data.archivo_carpeta = car.value;
    if (nom) data.archivo_nombre = nom.value;
    if (pc)  data.archivo_computadora = pc.value;

    return data;
  }

  function applyDraft(d) {
    if (!d) return;

    const nombre = document.getElementById('nombre_cliente');
    const tel = document.getElementById('telefono_cliente');
    const itemsJson = document.getElementById('items_json');
    const suc = document.getElementById('sucursal');
    const fecha = document.getElementById('fecha_entrega');
    const total = document.getElementById('total');
    const anticipo = document.getElementById('anticipo');
    const encargado = document.getElementById('encargado');
    const recibe = document.getElementById('recibe');

    const toggleExtra = document.getElementById('toggleExtra');

    const obs = document.getElementById('observaciones');
    const imp = document.getElementById('trabajo_impreso');
    const ent = document.getElementById('trabajo_entregado');
    const car = document.getElementById('archivo_carpeta');
    const nom = document.getElementById('archivo_nombre');
    const pc  = document.getElementById('archivo_computadora');

    const facturaSi = document.querySelector('input[name="requiere_factura"][value="si"]');
    const facturaNo = document.querySelector('input[name="requiere_factura"][value="no"]');

    if (nombre && !nombre.value && d.nombre_cliente) nombre.value = d.nombre_cliente;
    if (tel && !tel.value && d.telefono_cliente) tel.value = d.telefono_cliente;

    if (itemsJson && d.items_json) {
      itemsJson.value = d.items_json;
      try {
        const arr = JSON.parse(d.items_json || '[]');
        if (typeof setItemsToTable === 'function') setItemsToTable(arr);
      } catch {}
    }

    if (suc && (!suc.value || suc.value === '') && d.sucursal) suc.value = d.sucursal;
    if (fecha && !fecha.value && d.fecha_entrega) fecha.value = d.fecha_entrega;
    if (total && !total.value && (d.total ?? '') !== '') total.value = d.total;
    if (anticipo && !anticipo.value && (d.anticipo ?? '') !== '') anticipo.value = d.anticipo;
    if (encargado && !encargado.value && d.encargado) encargado.value = d.encargado;
    if (recibe && !recibe.value && d.recibe) recibe.value = d.recibe;

    if (facturaSi && facturaNo && d.requiere_factura) {
      if (d.requiere_factura === 'si') facturaSi.checked = true;
      if (d.requiere_factura === 'no') facturaNo.checked = true;
    }

    if (toggleExtra && typeof d.toggleExtra === 'boolean') toggleExtra.checked = d.toggleExtra;

    if (obs && !obs.value && d.observaciones) obs.value = d.observaciones;
    if (imp && d.trabajo_impreso === true) imp.checked = true;
    if (ent && d.trabajo_entregado === true) ent.checked = true;
    if (car && !car.value && d.archivo_carpeta) car.value = d.archivo_carpeta;
    if (nom && !nom.value && d.archivo_nombre) nom.value = d.archivo_nombre;
    if (pc  && !pc.value && d.archivo_computadora) pc.value = d.archivo_computadora;

    try { if (typeof calcularResto === 'function') calcularResto(); } catch {}
    try { validarRelacionTotales(); } catch {}
  }

  function hookAutosave() {
    const inputs = document.querySelectorAll('#print-area input, #print-area textarea, #print-area select');
    inputs.forEach(el => {
      el.addEventListener('input', () => setDraft(readFormValues()));
      el.addEventListener('change', () => setDraft(readFormValues()));
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    applyDraft(getDraft());
    hookAutosave();
  });

  document.addEventListener('DOMContentLoaded', () => {
     const hasSuccess = "<%= success ? 'true' : 'false' %>" === 'true';
    if (!hasSuccess) return;

    clearDraft();

    const form = document.querySelector('form.needs-validation');
    if (form) {
      form.reset();
      form.classList.remove('was-validated');
    }

    const toggle = document.getElementById('toggleExtra');
    if (toggle) toggle.checked = false;

    const panel = document.getElementById('extraPanel');
    if (panel) {
      panel.classList.add('is-disabled');
      panel.querySelectorAll('input, textarea, select').forEach(el => {
        el.disabled = true;
        if (el.type === 'checkbox') el.checked = false;
        else el.value = '';
      });
    }

    try {
      const tbody = document.getElementById('itemsTbody');
      if (tbody) tbody.innerHTML = '';
      if (typeof ensureAtLeastOneRow === 'function') ensureAtLeastOneRow();
      if (typeof syncItemsToHidden === 'function') syncItemsToHidden();
      if (typeof recalcTotalFromItems === 'function') recalcTotalFromItems();
    } catch {}

    const resto = document.getElementById('resto_preview');
    if (resto) resto.value = '';

    try { if (typeof cargarFolioGlobal === 'function') cargarFolioGlobal(); } catch {}
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('toggleExtra');
    const panel = document.getElementById('extraPanel');
    if (!toggle || !panel) return;

    const extraInputs = panel.querySelectorAll('input, textarea, select');

    function setEnabled(enabled) {
      panel.classList.toggle('is-disabled', !enabled);
      extraInputs.forEach(el => { el.disabled = !enabled; });

      if (!enabled) {
        extraInputs.forEach(el => {
          if (el.type === 'checkbox') el.checked = false;
          else el.value = '';
        });
      }

      try { setDraft(readFormValues()); } catch {}
    }

    toggle.addEventListener('change', () => setEnabled(toggle.checked));

    const d = (() => { try { return getDraft(); } catch { return {}; } })();
    if (typeof d.toggleExtra === 'boolean') toggle.checked = d.toggleExtra;

    setEnabled(!!toggle.checked);
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tel = document.getElementById('telefono_cliente');
    const total = document.getElementById('total');
    const anticipo = document.getElementById('anticipo');

    if (tel) {
      tel.addEventListener('input', () => {
        tel.value = String(tel.value || '').replace(/\D/g, '').slice(0, 10);
      });
    }

    function bloquearTeclasNoDeseadas(el) {
      if (!el) return;
      el.addEventListener('keydown', (e) => {
        if (e.key === '-' || e.key === '+' || e.key === 'e' || e.key === 'E') {
          e.preventDefault();
        }
      });
    }

    bloquearTeclasNoDeseadas(total);
    bloquearTeclasNoDeseadas(anticipo);

    function asegurarPositivo(el) {
      if (!el) return;
      el.addEventListener('input', () => {
        if (el.value === '') return;
        const n = Number(el.value);
        if (Number.isNaN(n) || n < 0) el.value = '0';
      });
    }

    asegurarPositivo(total);
    asegurarPositivo(anticipo);

    const revalidar = () => {
      try { if (typeof calcularResto === 'function') calcularResto(); } catch {}
      try { validarRelacionTotales(); } catch {}
    };
    total?.addEventListener('input', revalidar);
    anticipo?.addEventListener('input', revalidar);
  });
</script>

<script>
  const totalInput = document.getElementById('total');
  const anticipoInput = document.getElementById('anticipo');
  const restoInput = document.getElementById('resto_preview');

  function calcularResto() {
    const tRaw = totalInput.value;
    const aRaw = anticipoInput.value;

    if (tRaw === '' || aRaw === '') {
      restoInput.value = '';
      return;
    }

    const total = parseFloat(tRaw);
    const anticipo = parseFloat(aRaw);

    if (Number.isNaN(total) || Number.isNaN(anticipo) || total < 0 || anticipo < 0 || anticipo > total) {
      restoInput.value = '';
      return;
    }

    const resto = total - anticipo;
    restoInput.value = resto.toFixed(2);
  }

  totalInput.addEventListener('input', calcularResto);
  anticipoInput.addEventListener('input', calcularResto);
</script>

<script>
  const folioInput = document.getElementById('folio_preview');
  const formEl = document.querySelector('form[action="/pedidos"]') || document.querySelector('form');

  let folioIntervalId = null;
  let isFetchingFolio = false;

  async function cargarFolioGlobal() {
    if (isFetchingFolio) return;
    isFetchingFolio = true;

    try {
      const res = await fetch('/pedidos/next-folio', { cache: 'no-store' });
      if (!res.ok) return;

      const data = await res.json();
      const next = String(data.nextFolio ?? '').trim();
      if (!next) return;

      if (folioInput.value !== next) folioInput.value = next;
    } catch (e) {
    } finally {
      isFetchingFolio = false;
    }
  }

  function iniciarFolioLive() {
    cargarFolioGlobal();
    folioIntervalId = setInterval(cargarFolioGlobal, 2000);
  }

  function detenerFolioLive() {
    if (folioIntervalId) clearInterval(folioIntervalId);
    folioIntervalId = null;
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) detenerFolioLive();
    else iniciarFolioLive();
  });

  window.addEventListener('DOMContentLoaded', () => {
    iniciarFolioLive();
  });

  if (formEl) {
    formEl.addEventListener('submit', async () => {
      await cargarFolioGlobal();
    });
  }
</script>

